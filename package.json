{
  "name": "swarm-extension",
  "private": true,
  "version": "0.1.0",
  "description": "SWARM — copilote autonome multi-agents pour un compte X. Local-first, Manifest V3.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:selectors",
    "zip": "node --experimental-strip-types scripts/build-zip.ts",
    "measure:cache": "vitest run -c vitest.live.config.ts tests/live/prompt-cache.live.test.ts",
    "measure:qualifier": "vitest run -c vitest.live.config.ts tests/live/qualifier-cost.live.test.ts",
    "calibrate:critic": "vitest run -c vitest.live.config.ts tests/live/critic-calibration.live.test.ts",
    "live": "vitest run -c vitest.live.config.ts",
    "check:selectors": "node --experimental-strip-types scripts/check-selectors.ts",
    "e2e": "npm run build:e2e && playwright test",
    "build:e2e": "SWARM_E2E=1 vite build"
  },
  "dependencies": {
    "@xstate/react": "^6.0.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.5",
    "lucide-react": "^0.549.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "xstate": "^5.32.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.1.31",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
